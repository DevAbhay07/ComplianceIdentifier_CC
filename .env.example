# ============================================================
# NitiMark-ML Environment Configuration Template
# Copy this file to .env and insert your API credentials.
# NEVER commit your actual .env file or API keys to Git!
# ============================================================

# Vision / OCR API Configuration
VISION_PROVIDER=gemini
VISION_API_KEY=your_gemini_api_key_here
VISION_MODEL=gemini-3.6-flash

# Inference Settings
INFERENCE_LOGGING_ENABLED=true
INFERENCE_LOG_DIR=data/interim/inference_logs
