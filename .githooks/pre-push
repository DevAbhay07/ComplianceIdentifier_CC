#!/usr/bin/env bash
# .githooks/pre-push
# ==================
# Git pre-push hook — runs pytest before every push.
# If tests fail, the push is REJECTED.
#
# Setup (one-time):
#   git config core.hooksPath .githooks
#   chmod +x .githooks/pre-push
#
# Behaviour:
#   git push  →  hook runs pytest
#                 ├── PASS  → push proceeds
#                 └── FAIL  → push is blocked with error message

set -e

# ─── Colors ──────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'  # No Color

echo ""
echo -e "${YELLOW}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${YELLOW}║       NitiMark — Pre-Push Test Gate (pytest)                 ║${NC}"
echo -e "${YELLOW}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""
echo -e "${YELLOW}Running test suite before push...${NC}"
echo ""

# ─── Determine pytest invocation ─────────────────────────────────────────────
if [ -f ".venv/bin/pytest" ]; then
    PYTEST_CMD=".venv/bin/pytest"
elif [ -f "venv/bin/pytest" ]; then
    PYTEST_CMD="venv/bin/pytest"
elif command -v pytest >/dev/null 2>&1; then
    PYTEST_CMD="pytest"
elif command -v python3 >/dev/null 2>&1; then
    PYTEST_CMD="python3 -m pytest"
elif command -v python >/dev/null 2>&1; then
    PYTEST_CMD="python -m pytest"
else
    echo -e "${RED}Error: Neither .venv/bin/pytest, pytest, python3, nor python was found.${NC}"
    exit 1
fi

# ─── Run pytest ──────────────────────────────────────────────────────────────
if $PYTEST_CMD -q; then
    echo ""
    echo -e "${GREEN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${GREEN}║  ✔  All tests PASSED — push is allowed.                      ║${NC}"
    echo -e "${GREEN}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    exit 0
else
    echo ""
    echo -e "${RED}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  ✖  Tests FAILED — push is BLOCKED.                          ║${NC}"
    echo -e "${RED}║                                                              ║${NC}"
    echo -e "${RED}║  Fix the failing tests before pushing.                       ║${NC}"
    echo -e "${RED}║  Run: python -m pytest tests/api/ -v                         ║${NC}"
    echo -e "${RED}╚══════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    exit 1
fi
